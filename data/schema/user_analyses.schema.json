{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilienceengineers.github.io/wov-calendar/data/schema/user_analyses.schema.json",
  "title": "User analyses",
  "type": "object",
  "required": ["analyses"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "uploaded_by", "uploaded_at",
          "trigger_commodity", "trigger_geography",
          "industry_chain", "timeline_projection",
          "regions_affected", "narrative_md"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ua-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
          "uploaded_by": { "type": "string" },
          "uploaded_at": { "type": "string", "format": "date-time" },
          "trigger_commodity": { "type": "string" },
          "trigger_geography": { "type": "string" },
          "trigger_event_ref": { "type": ["string", "null"] },
          "industry_chain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["stage", "industry", "lead_time_days"],
              "additionalProperties": false,
              "properties": {
                "stage": { "type": "string" },
                "industry": { "type": "string" },
                "lead_time_days": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "timeline_projection": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["horizon_days", "expected_impact", "confidence"],
              "additionalProperties": false,
              "properties": {
                "horizon_days": { "type": "integer", "minimum": 0 },
                "expected_impact": { "type": "string" },
                "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
              }
            }
          },
          "regions_affected": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "narrative_md": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
