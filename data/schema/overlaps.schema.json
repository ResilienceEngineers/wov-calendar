{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilienceengineers.github.io/wov-calendar/data/schema/overlaps.schema.json",
  "title": "Convergence clusters (derived)",
  "type": "object",
  "required": ["computed_at", "clusters"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "computed_at": { "type": "string", "format": "date-time" },
    "executive_summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "headline": { "type": "string" },
        "chokepoint_phrase": { "type": "string" },
        "kpis": { "type": "object", "additionalProperties": true }
      }
    },
    "risk_by_month": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["month", "intensity"],
        "properties": {
          "month": { "type": "string" },
          "label": { "type": "string" },
          "intensity": { "type": "number" },
          "cluster_count": { "type": "integer" },
          "is_peak": { "type": "boolean" }
        }
      }
    },
    "chokepoint_board": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name", "state"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "throughput_note": { "type": "string" },
          "state": { "type": "string", "enum": ["red", "amber", "green"] },
          "exposure": { "type": "string" },
          "what_to_watch": { "type": "string" },
          "member_count": { "type": "integer" }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "axis", "axis_value", "time_window",
          "convergence_score", "member_event_ids",
          "shared_industries", "shared_commodities", "shared_regions",
          "shared_chokepoints"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^cluster-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$" },
          "axis": { "type": "string", "enum": ["region", "industry", "commodity", "chokepoint"] },
          "axis_value": { "type": "string" },
          "time_window": {
            "type": "array",
            "items": { "type": "string", "format": "date" },
            "minItems": 2, "maxItems": 2
          },
          "convergence_score": { "type": "number", "minimum": 0, "maximum": 10 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "peak_depth": { "type": "integer", "minimum": 1 },
          "score_breakdown": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "depth": { "type": "number" },
              "severity": { "type": "number" },
              "concentration": { "type": "number" },
              "signal": { "type": "number" },
              "chokepoint": { "type": "number" }
            }
          },
          "member_event_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "peak_member_ids": { "type": "array", "items": { "type": "string" } },
          "shared_industries": { "type": "array", "items": { "type": "string" } },
          "shared_commodities": { "type": "array", "items": { "type": "string" } },
          "shared_regions": { "type": "array", "items": { "type": "string" } },
          "shared_chokepoints": { "type": "array", "items": { "type": "string" } },
          "narrative_seed": { "type": ["string", "null"] }
        }
      }
    }
  }
}
